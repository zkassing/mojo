{
  // 参考示例：两套完整方案（终端 vibecoding / 看视频）。
  // 不是生效配置！想用哪套，把对应对象复制进 config.json 的 profiles 数组，
  // 或在面板「方案设置」里照着重建。兜底方案（无 match）必须放在数组最后。
  "profiles": [
    // ① 终端 vibecoding：方向键移动/翻页、菜单中断、主页切窗、语音输入
    {
      "name": "terminal",
      "match": {
        "bundleIds": [
          "com.apple.Terminal",
          "com.googlecode.iterm2",
          "dev.warp.Warp-Stable",
          "net.kovidgoyal.kitty",
          "com.github.wez.wezterm",
          "io.alacritty",
          "com.mitchellh.ghostty",
          "com.microsoft.VSCode",
          "com.todesktop.230313mzl4w4u92"
        ]
      },
      "bindings": {
        "ok":     { "tap": "return", "repeat": true },
        // 上下 = 命令历史；长按 = 翻页，用来快速浏览 AI 吐的长输出
        // （历史翻页不适合连发，容易过头，所以这里用长按换掉 repeat）
        "up":     { "tap": "up",
                    "long": "pageup" },
        "down":   { "tap": "down",
                    "long": "pagedown" },
        // 左右 = 光标移动（按住连续移）
        "left":   { "tap": "left", "repeat": true },
        "right":  { "tap": "right", "repeat": true },
        // 菜单 = Ctrl-C 中断当前命令；长按 = Ctrl-U 清空整行输入
        "menu":   { "tap": { "type": "key", "key": "c", "mods": ["ctrl"] },
                    "long": { "type": "key", "key": "u", "mods": ["ctrl"] } },
        // 返回 = 退格删除（按住连续删）
        // 注意：不能再加 long/double，否则引擎会禁掉 repeat 连发
        "back":   { "tap": "delete", "repeat": true },
        // 主页 = 切终端窗口；双击 = 新建标签页；长按 = Ctrl-R 反向搜历史
        "home":   { "tap": { "type": "key", "key": "tab", "mods": ["cmd"] },
                     "double": { "type": "key", "key": "t", "mods": ["cmd"] },
                     "long": { "type": "key", "key": "r", "mods": ["ctrl"] } },
        // 语音键 = 按住说话，松开识别并输入到命令行
        "voice":  { "tap": "dictate" },
        // 电源键 = Esc；双击 Ctrl-C 中断；长按 Ctrl-L 清屏
        // 系统自带的「按电源键睡眠」由 PowerButtonGuard 在 IOKit 层拦住
        "power":  { "tap": "escape",
                    "double": { "type": "key", "key": "c", "mods": ["ctrl"] },
                    "long":   { "type": "key", "key": "l", "mods": ["ctrl"] } },
        // 音量 +/− = 切换标签页。
        // Ctrl-Tab / Ctrl-Shift-Tab 是兼容最广的写法（Warp / VSCode / Ghostty / iTerm 都认）；
        // Terminal.app 用 Cmd-Shift-[/] ，如果你主用 Terminal.app 把下面两行换回去
        "volup":   { "tap": { "type": "key", "key": "tab", "mods": ["ctrl"] } },
        "voldown": { "tap": { "type": "key", "key": "tab", "mods": ["ctrl", "shift"] } },
        "tv":     { "tap": "none" }
      }
    },

    // ② 看视频：播放暂停、快进快退、全屏
    {
      "name": "video",
      "match": {
        "bundleIds": [
          "com.colliderli.iina",
          "org.videolan.vlc",
          "com.apple.TV",
          "com.apple.QuickTimePlayerX"
        ]
      },
      "bindings": {
        "ok":    { "tap": "space" },
        "left":  { "tap": "left",  "repeat": true },
        "right": { "tap": "right", "repeat": true },
        "up":    { "tap": { "type": "media", "key": "volup" },   "repeat": true },
        "down":  { "tap": { "type": "media", "key": "voldown" }, "repeat": true },
        "menu":  { "tap": "escape" },
        "back":  { "tap": "escape" },
        "home":  { "tap": { "type": "key", "key": "f", "mods": ["cmd", "ctrl"] } },
        "power": { "tap": "escape" },
        "volup":   { "tap": { "type": "passthrough" } },
        "voldown": { "tap": { "type": "passthrough" } },
        "tv":     { "tap": "none" }
      }
    }
  ]
}

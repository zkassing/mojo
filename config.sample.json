{
  "device": {
    "vendorId": "0x2717",
    "productId": "0x32b8",
    "name": "小米蓝牙语音遥控器"
  },
  "options": {
    "swallowOriginal": true,
    "longPressMs": 450,
    "doublePressMs": 280,
    // 按键去抖：遥控器一次物理按压有时会报两次，
    // 导致左右键单击跳两个字符。设 0 关闭。
    "debounceMs": 150,
    "verbose": false
  },

  // ── 语音转文字（按住语音键→遥控器开麦→松开→识别→输入）──
  "voice": {
    "locale": "zh-CN",
    "output": "type",            // type / typeEnter / clipboard
    "stripPunctuation": true,

    // 识别引擎：volc = 火山引擎流式大模型（边说边传，中英混说最强）
    //          apple = 系统自带，没网时的备胎
    "engine": "volc",
    "volcAppId": "",
    "volcAccessToken": "",
    // 小时版 volc.bigasr.sauc.duration / 并发版 volc.bigasr.sauc.concurrent
    "volcResourceId": "volc.bigasr.sauc.duration",
    // 边说边出字：流式中间结果实时写进输入框
    "liveTyping": true,
    // 纠正术语谐音误识（main → 闷、diff → 地府）
    "fixTerms": true,

    // 仅对 apple 引擎生效：true = 强制本地识别（不上传但准确率低）
    "onDevice": false
  },

  // ── 物理按键 → 逻辑名。已由实测抓包确认 ──
  "buttons": {
    "up":     ["kc:126"],
    "down":   ["kc:125"],
    "left":   ["kc:123"],
    "right":  ["kc:124"],
    "ok":     ["kc:36"],
    "menu":   ["kc:110"],
    "home":   ["kc:115"],
    "power":  ["aux:6"],
    "voice":  ["kc:96"],
    // 返回键发的是 HID Keyboard usage 0xF1，macOS 不认识、不会产生键盘事件，
    // 所以走 hid: 直读通道（需要「输入监控」权限）
    "back":   ["hid:7:241"],
    "volup":   ["aux:0"],
    "voldown": ["aux:1"],
    "tv":     ["kc:50"]        // TV 键（macOS 键码 50，反引号）
  },

  // ── 方案：默认只有一个全局兜底方案 ──
  // 想按前台 App 自动切换键位？在面板「方案设置」里新建方案、
  // 填上该 App 的 Bundle ID 即可。参考示例见 config.example-terminal.json。
  "profiles": [
    {
      "name": "默认配置",
      "bindings": {
        "ok":    { "tap": { "type": "media", "key": "playpause" } },
        "left":  { "tap": { "type": "media", "key": "previous" } },
        "right": { "tap": { "type": "media", "key": "next" } },
        "up":    { "tap": { "type": "media", "key": "volup" },   "repeat": true },
        "down":  { "tap": { "type": "media", "key": "voldown" }, "repeat": true },
        "menu":  { "tap": "escape" },
        "back":  { "tap": "escape" },
        "home":  { "tap": { "type": "key", "key": "tab", "mods": ["cmd"] } },
        "voice": { "tap": "dictate" },
        // 电源键 = Esc（不绑睡眠，避免误触）
        "power": { "tap": "escape" },
        "volup":   { "tap": { "type": "passthrough" } },
        "voldown": { "tap": { "type": "passthrough" } },
        "tv":    { "tap": "none" }
      }
    }
  ]
}
